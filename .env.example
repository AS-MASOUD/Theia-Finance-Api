# Application Configuration
PROJECT_NAME="Personal Finance Command Center"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# Cryptographic Key (Minimum 32 characters, fail-fast enforced in production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Identity & Brute-Force Lockout Policies
MAX_FAILED_ACCESS_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ALLOWED_LOCKOUT_FOR_NEW_USERS=true
MIN_PASSWORD_LENGTH=8

# Database Configuration (PostgreSQL with asyncpg driver)
# Do NOT use default passwords such as 'admin' or 'postgres' in production
DATABASE_URL="postgresql+asyncpg://personal_fc_user:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/personal_fc"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration (Cache & ARQ background tasks)
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration (JSON array string)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Market Data & AI Integration Settings ("mock" for offline environments)
MARKET_DATA_PROVIDER="mock"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional Seed Bootstrap Credentials
BOOTSTRAP_ADMIN_EMAIL="admin@your-domain.com"
BOOTSTRAP_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_8_CHARS"
BOOTSTRAP_SYSMANAGER_EMAIL="sysmanager@your-domain.com"

# Communications, OTP & Bale Messenger Safir Integration
# Bale Safir Documentation: https://docs.bale.ai/safir
# Business Panel: https://business.bale.ai/
BALE_PROVIDER="mock"  # "mock" for dev/offline testing, "safir" for production
BALE_API_ACCESS_KEY="REPLACE_WITH_BALE_ORGANIZATION_API_ACCESS_KEY"
BALE_BOT_ID=123456789  # Numeric Bot ID from Bale Business Panel
BALE_BASE_URL="https://safir.bale.ai/api/v3"

# Dual-Delivery Strategy:
# - bale_first: Delivers via Bale messenger, automatically falls back to SMS if user is not on Bale (code 17) or delivery fails
# - bale_only: Exclusively delivers via Bale messenger
# - sms_only: Delivers via SMS gateway
OTP_DELIVERY_STRATEGY="bale_first"

# SMS Gateway Providers (Iranian SMS: kavenegar, farazsms, mock)
SMS_PROVIDER="mock"
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
FARAZSMS_API_KEY=""
FARAZSMS_SENDER=""
FARAZSMS_PATTERN_CODE=""

